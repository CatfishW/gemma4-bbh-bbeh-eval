[Unit]
Description=Gemma 4 E2B SGLang server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=CONDA_PREFIX=/home/benwulab/anaconda3/envs/SGLang
Environment=PATH=/home/benwulab/anaconda3/envs/SGLang/bin:/home/benwulab/anaconda3/condabin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/benwulab/anaconda3/envs/SGLang/bin/python /home/benwulab/run_sglang_qwen.py --model-path /data/models/gemma-4-E2B-it --served-model-name SubTokenLLM-E2B --context-length 131072 --dtype bfloat16 --mem-fraction-static 0.58 --max-total-tokens 131072 --chunked-prefill-size 4096 --max-prefill-tokens 8192 --enable-multimodal --reasoning-parser gemma4 --tool-call-parser gemma4 --sampling-backend pytorch --attention-backend triton --disable-cuda-graph --stream-interval 1 --watchdog-timeout 1800 --trust-remote-code --allow-auto-truncate --host 0.0.0.0 --port 8889
Restart=always
RestartSec=10
TimeoutStopSec=120
KillMode=control-group
LimitNOFILE=1048576

[Install]
WantedBy=default.target
